# Copy to .env and fill in real values. Never commit .env.
# apps/api reads these via app/core/config.py (pydantic-settings).
# apps/web will read the NEXT_PUBLIC_* subset once Phase 2 (auth) adds
# client-side Supabase usage — service-role keys are server-only and
# must never be prefixed NEXT_PUBLIC_ or shipped to the browser.

ENVIRONMENT=development

# Supabase (hosted project — see docs/architecture/phase0-assessment.md)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — apps/api only, never apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# apps/web reads these directly (client + server) — NEXT_PUBLIC_ vars are
# shipped to the browser, so only the URL and anon key go here, never the
# service-role key above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI (Phase 5+: structured extraction, internal control AI fallback,
# control mapping — all call this)
OPENAI_API_KEY=

# Background jobs (Celery, Phase 4+: extraction, analysis, internal
# control parsing, and control mapping all run as worker tasks — see
# README.md "Running locally" for the worker start command)
REDIS_URL=redis://localhost:6379/0
